        DECIMAL(5,2) Comision_empleada
        BOOLEAN Activa_empleada
    }
    especialidadesEmpleada["Especialidades_empleada"] {
        INT Id_especialidad_empleada PK
        INT Empleada_id_especialidad FK
        INT Servicio_id_especialidad FK
    }
    horarios["Horarios"] {
        INT Id_horario PK
