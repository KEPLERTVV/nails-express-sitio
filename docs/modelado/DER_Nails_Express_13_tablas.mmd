        SMALLINT Reprogramaciones_cita
        VARCHAR(20) Cancelada_por_cita "NULL"
        BOOLEAN Asignada_al_atender_cita
    }
    solicitudesDisponibilidad["Solicitudes_disponibilidad"] {
        INT Id_solicitud_disponibilidad PK
        INT Empleada_id_solicitud FK
        DATE Fecha_cierre_solicitud
